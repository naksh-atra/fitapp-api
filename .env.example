# ============================================================================
# LLM Configuration - Modular provider system
# ============================================================================
# All LLM settings are controlled via environment variables.
# Switch providers by changing LLM_PROVIDER value below.
#
# Supported providers: openrouter, deepseek
# To add new providers: update PROVIDER_URLS and PROVIDER_KEYS in llm_client.py
# ============================================================================

# --- Provider Selection (REQUIRED) ---
# Options: "openrouter" (recommended - free models), "deepseek" (paid)
# Default if not set: "openrouter"
LLM_PROVIDER=openrouter

# --- OpenRouter Configuration (recommended - free models) ---
# Get free API key from: https://openrouter.ai/settings
# Recommended free models:
#   - llama-3.3-70b-instruct:free (best quality, reliable)
#   - gemma-3-12b-it:free (fast, lightweight)
#   - qwen/qwen3-next-80b-a3b-instruct:free (advanced, NOT in UI dropdown)
OPENROUTER_API_KEY=

# --- DeepSeek Configuration (optional - paid) ---
# Uncomment to use DeepSeek instead of OpenRouter:
# Get key from: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=

# --- Model Settings ---
# Model name - must be valid for selected provider
# OpenRouter models: see https://openrouter.ai/models
# DeepSeek models: "deepseek-chat", "deepseek-coder"
LLM_MODEL=llama-3.3-70b-instruct

# --- Generation Parameters ---
# Temperature: 0.0 = deterministic, 0.7 = creative, 1.0 = random
# Lower = more consistent verdicts (recommended: 0.0 for validation)
LLM_TEMPERATURE=0.0

# Max tokens: higher = longer responses, more detailed analysis
# Default: 800 (sufficient for verdict + analysis)
# LLM_MAX_TOKENS=800

# --- Custom Endpoint (optional) ---
# Override default endpoint for a provider
# Use when running local LLM (e.g., Ollama, LM Studio)
# Example: LLM_BASE_URL=http://localhost:11434/v1/chat/completions
# LLM_BASE_URL=

# ============================================================================
# Web Search - Tavily (REQUIRED)
# ============================================================================
# 1000 free queries/month
# Get key from: https://tavily.com/
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ============================================================================
# Database (REQUIRED)
# ============================================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=Fitapp

# ============================================================================
# Authentication (REQUIRED)
# ============================================================================
# JWT secret for token signing - use a strong secret (32+ characters recommended)
JWT_SECRET=your-secret-key-here