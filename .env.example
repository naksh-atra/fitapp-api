# ===========================================
# LLM Provider Configuration
# ===========================================
# Choose one: openrouter (free llama) or deepseek (paid)
LLM_PROVIDER=openrouter

# OpenRouter (recommended - free models available)
# Get key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
LLM_MODEL=llama-3.3-70b-instruct

# Alternative: DeepSeek (optional, paid)
# Get key from https://platform.deepseek.com/
# DEEPSEEK_API_KEY=

# ===========================================
# Web Search - Tavily
# ===========================================
# 1000 free queries/month
# Get key from https://tavily.com/
TAVILY_API_KEY=

# ===========================================
# Database
# ===========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=Fitapp

# ===========================================
# Auth
# ===========================================
JWT_SECRET=your-secret-key-here